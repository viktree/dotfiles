# ---{ Homebrew Tap Sources }------------------------------------------------------------
#
#   Package repositories for Homebrew.
#

cask_args appdir: '/Applications'
cask_args fontdir: '/Library/Fonts'

tap 'hashicorp/tap'                 # HashiCorp tools (Vault, Terraform, etc.)
tap 'homebrew/bundle'               # Brewfile/bundle support
tap 'homebrew/services'             # Service management
tap 'menubar-apps/menubar-apps'     # Menubar utility apps
tap 'mongodb/brew'                  # MongoDB tools
tap 'ankitpokhrel/jira-cli'

